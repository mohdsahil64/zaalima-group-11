{
  "env": {
    "node": true,
    "es2024": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["log", "warn", "error"] }],
    "consistent-return": "warn",
    "no-process-exit": "off"
  }
}
